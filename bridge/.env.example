# Usuario de TikTok que está en vivo (sin @)
TIKTOK_USERNAME=tu_usuario
# Puerto del WebSocket local al que se conecta el juego
WS_PORT=8080
# Opcional: clave de Groq para que el presentador converse con el chat con IA (gratis con límites).
# Sin clave, el bot usa solo sus frases armadas. NUNCA subas el archivo .env a ningún repositorio.
GROQ_API_KEY=
# Alternativa: clave de la API de Claude (si en config/bot.json ponés "provider": "anthropic").
ANTHROPIC_API_KEY=
